[Unit]
Description=Backup Marshrut Postroen bot SQLite database

[Service]
Type=oneshot
User=marsrut-bot
Group=marsrut-bot
WorkingDirectory=/opt/marsrut-bot
EnvironmentFile=/opt/marsrut-bot/.env
ExecStart=/opt/marsrut-bot/.venv/bin/python -m scripts.backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/marsrut-bot/data /opt/marsrut-bot/backups
