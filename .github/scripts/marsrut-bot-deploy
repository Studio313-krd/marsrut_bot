#!/usr/bin/env bash
set -Eeuo pipefail

readonly APP_DIR="/opt/marsrut-bot"
readonly APP_USER="marsrut-bot"
readonly DEPLOY_USER="marsrut-deploy"
readonly SERVICE="marsrut-bot.service"
readonly HEALTH_URL="http://127.0.0.1:8081/health"
readonly PYTHON="$APP_DIR/.venv/bin/python"
readonly PIP="$APP_DIR/.venv/bin/pip"

die() {
  printf 'Deployment error: %s\n' "$*" >&2
  exit 1
}

run_as_app() {
  /usr/sbin/runuser -u "$APP_USER" -- "$@"
}

preflight() {
  [[ "$(id -u)" -eq 0 ]] || die "this helper must run through sudo"
  getent passwd "$APP_USER" >/dev/null || die "user $APP_USER does not exist"
  getent passwd "$DEPLOY_USER" >/dev/null || die "user $DEPLOY_USER does not exist"
  [[ -d "$APP_DIR" && ! -L "$APP_DIR" ]] || die "$APP_DIR is missing or is a symlink"
  [[ -f "$APP_DIR/.env" && ! -L "$APP_DIR/.env" ]] || die "$APP_DIR/.env is missing or is a symlink"
  [[ -d "$APP_DIR/.venv" && ! -L "$APP_DIR/.venv" ]] || die "$APP_DIR/.venv is missing or is a symlink"
  [[ -x "$PYTHON" && -x "$PIP" ]] || die "the application virtual environment is incomplete"
  [[ -f "$APP_DIR/requirements.txt" ]] || die "requirements.txt is missing"
  [[ -d "$APP_DIR/data" && ! -L "$APP_DIR/data" ]] || die "data directory is missing or is a symlink"
  [[ -d "$APP_DIR/backups" && ! -L "$APP_DIR/backups" ]] || die "backups directory is missing or is a symlink"
  run_as_app /usr/bin/test -w "$APP_DIR" || die "$APP_USER cannot write to $APP_DIR"
  run_as_app /usr/bin/test -w "$APP_DIR/.venv" || die "$APP_USER cannot update the virtual environment"
  run_as_app /usr/bin/test -w "$APP_DIR/backups" || die "$APP_USER cannot write backups"
  /usr/bin/systemctl is-active --quiet "$SERVICE" || die "$SERVICE is not active"
}

validate_archive() {
  local archive=$1

  [[ -f "$archive" && ! -L "$archive" ]] || die "release archive is missing or is a symlink"
  [[ "$(/usr/bin/readlink -f -- "$archive")" == "$archive" ]] || die "unexpected release archive path"
  [[ "$(/usr/bin/stat -c '%U' -- "$archive")" == "$DEPLOY_USER" ]] || die "release archive has an unexpected owner"
  [[ -z "$(/usr/bin/find "$archive" -maxdepth 0 -perm /022 -print -quit)" ]] || die "release archive is group/world writable"

  run_as_app /usr/bin/python3 - "$archive" <<'PY'
import sys
import tarfile
from pathlib import PurePosixPath

archive = sys.argv[1]
protected = {".env", ".venv", "data", "logs", "backups"}
max_members = 20_000
max_unpacked_size = 512 * 1024 * 1024
total_size = 0

with tarfile.open(archive, "r:gz") as bundle:
    members = bundle.getmembers()
    if len(members) > max_members:
        raise SystemExit("release archive contains too many entries")

    for member in members:
        path = PurePosixPath(member.name)
        parts = tuple(part for part in path.parts if part not in {"", "."})
        if path.is_absolute() or ".." in parts:
            raise SystemExit(f"unsafe archive path: {member.name!r}")
        if parts:
            top = parts[0]
            if top in protected or (top.startswith(".env.") and top != ".env.example"):
                raise SystemExit(f"protected path in release archive: {member.name!r}")
        if member.issym() or member.islnk():
            raise SystemExit(f"links are not allowed in release archive: {member.name!r}")
        if not (member.isfile() or member.isdir()):
            raise SystemExit(f"special file is not allowed in release archive: {member.name!r}")
        total_size += member.size
        if total_size > max_unpacked_size:
            raise SystemExit("release archive is too large")
PY
}

sync_code_from() {
  local source_dir=$1

  run_as_app /usr/bin/python3 - "$source_dir" "$APP_DIR" <<'PY'
import shutil
import sys
from pathlib import Path

source = Path(sys.argv[1])
destination = Path(sys.argv[2])
protected = {".env", ".venv", "data", "logs", "backups"}

for current in destination.iterdir():
    if current.name in protected:
        continue
    if current.is_symlink() or current.is_file():
        current.unlink()
    elif current.is_dir():
        shutil.rmtree(current)
    else:
        current.unlink()

for item in source.iterdir():
    target = destination / item.name
    if item.is_dir():
        shutil.copytree(item, target)
    else:
        shutil.copy2(item, target)
PY
}

new_staging_dir() {
  local staging
  staging="$(run_as_app /usr/bin/mktemp -d /tmp/marsrut-bot-release.XXXXXXXXXX)"
  [[ "$staging" == /tmp/marsrut-bot-release.* ]] || die "unexpected staging directory"
  printf '%s\n' "$staging"
}

remove_staging_dir() {
  local staging=${1:-}
  if [[ "$staging" == /tmp/marsrut-bot-release.* && -d "$staging" && ! -L "$staging" ]]; then
    run_as_app /usr/bin/rm -rf -- "$staging"
  fi
}

preflight

if [[ $# -eq 1 && "$1" == "--check" ]]; then
  /usr/bin/curl -fsS "$HEALTH_URL" >/dev/null || die "health check failed"
  printf 'Deployment helper is ready for %s\n' "$SERVICE"
  exit 0
fi

[[ $# -eq 1 ]] || die "usage: $0 <40-character release SHA>"
readonly DEPLOY_SHA=$1
[[ "$DEPLOY_SHA" =~ ^[0-9a-f]{40}$ ]] || die "invalid release SHA"

readonly ARCHIVE="/tmp/marsrut_bot_${DEPLOY_SHA}.tar.gz"
readonly BACKUP="$APP_DIR/backups/code-before-${DEPLOY_SHA}.tar.gz"
validate_archive "$ARCHIVE"

cd "$APP_DIR"
run_as_app "$PYTHON" -m scripts.backup
run_as_app /usr/bin/tar \
  --exclude=.venv \
  --exclude=.env \
  --exclude=data \
  --exclude=logs \
  --exclude=backups \
  -czf "$BACKUP" \
  -C "$APP_DIR" .

STAGING="$(new_staging_dir)"
run_as_app /usr/bin/tar -xzf "$ARCHIVE" -C "$STAGING"

rollback() {
  local exit_code=${1:-$?}
  trap - ERR INT TERM
  set +e
  printf 'Deployment failed; restoring the previous application code\n' >&2
  /usr/bin/systemctl stop "$SERVICE" || true

  local rollback_staging=""
  rollback_staging="$(run_as_app /usr/bin/mktemp -d /tmp/marsrut-bot-release.XXXXXXXXXX)" || true
  if [[ "$rollback_staging" == /tmp/marsrut-bot-release.* ]] && \
    run_as_app /usr/bin/tar -xzf "$BACKUP" -C "$rollback_staging"; then
    sync_code_from "$rollback_staging"
    cd "$APP_DIR"
    run_as_app "$PIP" install -r requirements.txt || true
  fi
  remove_staging_dir "$rollback_staging"
  remove_staging_dir "$STAGING"
  /usr/bin/systemctl start "$SERVICE" || true
  exit "$exit_code"
}
trap 'rollback $?' ERR
trap 'rollback 130' INT
trap 'rollback 143' TERM

/usr/bin/systemctl stop "$SERVICE"
sync_code_from "$STAGING"
cd "$APP_DIR"
run_as_app "$PIP" install -r requirements.txt
run_as_app "$PYTHON" -m compileall -q app scripts run.py
/usr/bin/systemctl start "$SERVICE"

healthy=false
for _attempt in $(/usr/bin/seq 1 30); do
  if /usr/bin/curl -fsS "$HEALTH_URL" >/dev/null; then
    healthy=true
    break
  fi
  /usr/bin/sleep 1
done
if [[ "$healthy" != true ]]; then
  printf 'Deployment error: health check did not become ready\n' >&2
  rollback 1
fi
/usr/bin/systemctl is-active --quiet "$SERVICE"

trap - ERR INT TERM
remove_staging_dir "$STAGING"
/usr/bin/rm -f -- "$ARCHIVE"
printf 'Successfully deployed %s\n' "$DEPLOY_SHA"
