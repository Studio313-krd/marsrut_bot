APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8080
APP_SECRET=replace-with-at-least-32-random-characters
PUBLIC_BASE_URL=https://bot.example.ru
SITE_BASE_URL=https://xn----7sbqzieaghadljej2f.xn--p1ai
SITE_PUBLIC_URL=https://xn----7sbqzieaghadljej2f.xn--p1ai
PRIVACY_URL=https://xn----7sbqzieaghadljej2f.xn--p1ai/privacy-policy
DATABASE_PATH=/opt/marsrut-bot/data/bot.sqlite3
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

# Must match BOT_API_* on the website server.
BOT_API_KEY_ID=marsrut-bot-v1
BOT_API_SECRET=replace-with-the-same-hmac-secret-as-on-the-site

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_IDS=123456789

MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=replace-with-random-webhook-secret
MAX_BOT_USERNAME=
MAX_ADMIN_IDS=
# MAX API requires a trusted Russian CA chain on some VPS images.
# SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

EVENT_POLL_INTERVAL_SECONDS=5
REMINDER_POLL_INTERVAL_SECONDS=60
DAILY_DIGEST_HOUR=9
OUTBOX_RETENTION_DAYS=30

# Dedicated read-only API for lk-batagov-bot. Empty disables the integration.
LEADERSHIP_REPORT_KEY=
